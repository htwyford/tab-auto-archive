{
  "manifest_version": 3,
  "name": "Tab Auto-Archive",
  "version": "1.1.1",
  "description": "Arc-style auto-archive: unpinned tabs you haven't looked at in a while are closed automatically. Find them again in History.",
  "author": "Harry Twyford",
  "homepage_url": "https://github.com/htwyford/tab-auto-archive",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-auto-archive@harrytwyford.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
